<Window x:Class="SeeMe.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SeeMe 设置"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="system-ui, -apple-system, 'Microsoft YaHei', sans-serif"
        FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Placeholder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- 扁平下拉框：与应用设计语言一致（InputBg 底 / 细边框 / 圆角 / 主题化下拉面板） -->
        <Style x:Key="SettingsCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightGrayBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="2,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource InputRadius}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"/>
                                    <!-- 透明 ToggleButton 覆盖整个字段：点任意位置弹下拉；chevron 靠右显示 -->
                                    <ToggleButton x:Name="toggle"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" ClickMode="Press"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Path x:Name="chev" Data="{StaticResource IconChevronDown}"
                                              Width="10" Height="10" Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                        </Path>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=bd}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource LightGrayBrush}" BorderThickness="0.5"
                                        CornerRadius="8" Padding="3" Margin="0,4,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Effect="{DynamicResource CardShadow}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="chev" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧分区导航 ═══ -->
        <Border Grid.Column="0" Margin="0,0,10,0"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="{DynamicResource PanelRadius}"
                Padding="8">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnNavChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9"/>
                        <Setter Property="Margin" Value="2,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem Tag="0" IsSelected="True"><TextBlock Text="⚙  通用设置" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/></ListBoxItem>
                <ListBoxItem Tag="1"><TextBlock Text="🎨  外观设置" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/></ListBoxItem>
                <ListBoxItem Tag="2"><TextBlock Text="📖  阅读设置" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/></ListBoxItem>
                <ListBoxItem Tag="3"><TextBlock Text="⌨  快捷键" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/></ListBoxItem>
                <ListBoxItem Tag="4"><TextBlock Text="📤  导出设置" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/></ListBoxItem>
                <ListBoxItem Tag="6"><TextBlock Text="⚡  高级设置" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/></ListBoxItem>
                <ListBoxItem Tag="7"><TextBlock Text="ℹ  关于" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/></ListBoxItem>
            </ListBox>
        </Border>

        <!-- ═══ 右侧内容区 ═══ -->
        <Grid Grid.Column="1">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="{DynamicResource PanelRadius}" Padding="20,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>

                        <!-- ════════ 0 通用设置 ════════ -->
                        <StackPanel x:Name="Sec0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="通用设置"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="启动时打开"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="StartupOpenBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnStartupOpenChanged">
                                    <ComboBoxItem Content="上次关闭的文件"/>
                                    <ComboBoxItem Content="空白页"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="默认打开方式"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="StartupSplitBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnStartupSplitChanged">
                                    <ComboBoxItem Content="单栏"/>
                                    <ComboBoxItem Content="双栏对比"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="最近文件数量"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="HistorySizeBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnHistorySizeChanged">
                                    <ComboBoxItem Content="10 条"/>
                                    <ComboBoxItem Content="15 条"/>
                                    <ComboBoxItem Content="20 条"/>
                                    <ComboBoxItem Content="50 条"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="关闭窗口时"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="CloseBehaviorBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnCloseBehaviorChanged">
                                    <ComboBoxItem Content="直接退出"/>
                                    <ComboBoxItem Content="最小化到托盘"/>
                                    <ComboBoxItem Content="每次询问"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="编辑自动保存"/>
                                <CheckBox x:Name="AutoSaveBox" Grid.Column="1" Content="输入停顿后自动保存（免手动 Ctrl+S）" FontSize="12"
                                          VerticalAlignment="Center" Checked="OnAutoSaveChanged" Unchecked="OnAutoSaveChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="自动保存间隔"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="AutoSaveDelayBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnAutoSaveDelayChanged">
                                    <ComboBoxItem Content="5 秒"/>
                                    <ComboBoxItem Content="10 秒"/>
                                    <ComboBoxItem Content="30 秒"/>
                                </ComboBox>
                            </Grid>
                            <Separator Margin="0,10,0,12" Opacity="0.3"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="文件关联" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AssocStatus" Style="{StaticResource SubNote}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="设为 .md 默认查看器" Style="{StaticResource ChipBtn}" Padding="12,5"
                                        FontSize="11" Click="OnAssocSetMd"/>
                                <Button Content="注册右键菜单" Style="{StaticResource ChipBtn}" Padding="12,5"
                                        FontSize="11" Margin="6,0,0,0" Click="OnAssocSetMenu"/>
                                <Button Content="取消全部关联" Style="{StaticResource ChipBtn}" Padding="12,5"
                                        FontSize="11" Margin="6,0,0,0" Click="OnAssocClear"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubNote}"
                                       Text="写入 HKCU 注册表，无需管理员权限。若系统默认应用已被其他程序锁定，需在「设置 → 默认应用」中手动更改。"/>
                        </StackPanel>

                        <!-- ════════ 1 外观设置 ════════ -->
                        <StackPanel x:Name="Sec1" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="外观设置"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="主题" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="浅色" FontSize="12" Margin="0,0,18,0" Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="深色" FontSize="12" Margin="0,0,18,0" Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="跟随系统" FontSize="12" Checked="OnThemeModeChanged"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="主题色" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="AccentIndigo" GroupName="Accent" Content="靛蓝" FontSize="12" Margin="0,0,18,0" Checked="OnAccentChanged"/>
                                <RadioButton x:Name="AccentBlue" GroupName="Accent" Content="蓝色" FontSize="12" Margin="0,0,18,0" Checked="OnAccentChanged"/>
                                <RadioButton x:Name="AccentGreen" GroupName="Accent" Content="绿色" FontSize="12" Checked="OnAccentChanged"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="界面缩放（默认）"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="DefaultZoomBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnDefaultZoomChanged">
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="125%"/>
                                    <ComboBoxItem Content="150%"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="信息面板（默认）"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="InfoPanelBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnInfoPanelDefaultChanged">
                                    <ComboBoxItem Content="展开"/>
                                    <ComboBoxItem Content="收起"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="动画效果"/>
                                <CheckBox x:Name="AnimationsBox" Grid.Column="1" Content="主题切换过渡动画（低配机可关）" FontSize="12"
                                          VerticalAlignment="Center" Checked="OnAnimationsChanged" Unchecked="OnAnimationsChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="字体大小"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="FontSizeBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnFontSizeChanged">
                                    <ComboBoxItem Content="小（13px）"/>
                                    <ComboBoxItem Content="标准（14px）"/>
                                    <ComboBoxItem Content="大（16px）"/>
                                    <ComboBoxItem Content="特大（18px）"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="行高"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="RowHeightBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnRowHeightChanged">
                                    <ComboBoxItem Content="紧凑（1.4）"/>
                                    <ComboBoxItem Content="标准（1.65）"/>
                                    <ComboBoxItem Content="宽松（2.0）"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- ════════ 2 阅读设置 ════════ -->
                        <StackPanel x:Name="Sec2" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="阅读设置"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Markdown 渲染风格" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="StyleDefault" GroupName="MdStyle" Content="默认风格" FontSize="12" Margin="0,0,18,0" IsChecked="True" Checked="OnMdStyleChanged"/>
                                <RadioButton x:Name="StyleGithub" GroupName="MdStyle" Content="GitHub 风格" FontSize="12" Margin="0,0,18,0" Checked="OnMdStyleChanged"/>
                                <RadioButton x:Name="StyleSimple" GroupName="MdStyle" Content="简约" FontSize="12" Checked="OnMdStyleChanged"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="自定义 CSS" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CssPathBox" FontSize="11" VerticalContentAlignment="Center"
                                         Padding="8,6" Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource LightGrayBrush}" BorderThickness="0.5"
                                         Foreground="{DynamicResource TextBodyBrush}"/>
                                <Button Grid.Column="1" Content="选择…" Style="{StaticResource ChipBtn}" Margin="6,0,0,0" Padding="12,5"
                                        FontSize="11" Click="OnPickCss"/>
                                <Button Grid.Column="2" Content="清除" Style="{StaticResource ChipBtn}" Margin="6,0,0,0" Padding="12,5"
                                        FontSize="11" Click="OnClearCss"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="护眼模式"/>
                                <CheckBox x:Name="EyeCareBox" Grid.Column="1" Content="暖色调 / 降低蓝光" FontSize="12" VerticalAlignment="Center"
                                          Checked="OnEyeCareChanged" Unchecked="OnEyeCareChanged"/>
                            </Grid>
                        </StackPanel>

                        <!-- ════════ 3 快捷键 ════════ -->
                        <StackPanel x:Name="Sec3" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="快捷键"/>
                            <TextBlock Style="{StaticResource SubNote}" Text="当前内置快捷键（自定义绑定 · 即将支持）" Margin="0,0,0,10"/>
                            <ListBox x:Name="KeymapList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </StackPanel>

                        <!-- ════════ 4 导出设置 ════════ -->
                        <StackPanel x:Name="Sec4" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="导出设置"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="图片格式"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="ImageFormatBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnImageFormatChanged">
                                    <ComboBoxItem Content="PNG（清晰）"/>
                                    <ComboBoxItem Content="JPG（体积小）"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="图片分辨率"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="ImageScaleBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnImageScaleChanged">
                                    <ComboBoxItem Content="1x（屏幕大小）"/>
                                    <ComboBoxItem Content="2x（高清）"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="默认导出路径"/>
                                <ComboBox Style="{StaticResource SettingsCombo}" x:Name="ExportPathModeBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="OnExportPathModeChanged">
                                    <ComboBoxItem Content="每次询问"/>
                                    <ComboBoxItem Content="固定文件夹"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExportPathBox" FontSize="11" VerticalContentAlignment="Center"
                                         Padding="8,6" Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource LightGrayBrush}" BorderThickness="0.5"
                                         Foreground="{DynamicResource TextBodyBrush}" IsEnabled="False"/>
                                <Button Grid.Column="1" Content="选择…" Style="{StaticResource ChipBtn}" Margin="6,0,0,0" Padding="12,5"
                                        FontSize="11" IsEnabled="False" Click="OnPickExportPath"/>
                            </Grid>
                            <Border Style="{StaticResource Placeholder}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="PDF 导出（目录 / 页码 / 水印）· 即将支持" Opacity="0.5"/>
                            </Border>
                        </StackPanel>

                        <!-- ════════ 6 高级设置 ════════ -->
                        <StackPanel x:Name="Sec6" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="高级设置"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="开发者工具"/>
                                <CheckBox x:Name="DevToolsBox" Grid.Column="1" Content="启用 F12 打开 DevTools（调试用）" FontSize="12"
                                          VerticalAlignment="Center" Checked="OnDevToolsChanged" Unchecked="OnDevToolsChanged"/>
                            </Grid>
                            <TextBlock Style="{StaticResource RowLabel}" Text="数据目录" Margin="0,0,0,4"/>
                            <TextBox x:Name="DataDirBox" FontSize="11" IsReadOnly="True" Padding="8,6"
                                     Background="{DynamicResource InputBgBrush}" BorderThickness="0"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Style="{StaticResource SubNote}" Text="历史、书签与设置存储于该目录。" Margin="0,4,0,12"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="缓存管理" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CacheBox" FontSize="11" IsReadOnly="True" Padding="8,6"
                                         Background="{DynamicResource InputBgBrush}" BorderThickness="0"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button Grid.Column="1" Content="清理" Style="{StaticResource ChipBtn}" Margin="6,0,0,0" Padding="14,5"
                                        FontSize="11" Click="OnClearCache"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SubNote}" Text="删除 WebView2 缓存目录（运行中的文件跳过，重启后完全生效）。" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- ════════ 7 关于 ════════ -->
                        <StackPanel x:Name="Sec7" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="关于"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock x:Name="AboutVersion" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource SubNote}" Text="轻量 · 快速 · 离线可用的多格式文档查看器（Markdown / PDF / Word / Excel / PPT）"/>
                                <TextBlock Style="{StaticResource SubNote}" Text="基于 WPF + WebView2 + .NET 8，Markdig 渲染管线，KaTeX / Prism / Mermaid 离线资源。"
                                           Margin="0,4,0,0"/>
                                <Separator Margin="0,14" Opacity="0.3"/>
                                <TextBlock Style="{StaticResource RowLabel}" Text="数据目录"/>
                                <TextBox x:Name="AboutDataDir" FontSize="11" IsReadOnly="True" Padding="8,6" Margin="0,4,0,0"
                                         Background="{DynamicResource InputBgBrush}" BorderThickness="0"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Style="{StaticResource RowLabel}" Text="安装位置" Margin="0,10,0,0"/>
                                <TextBox x:Name="AboutInstallDir" FontSize="11" IsReadOnly="True" Padding="8,6" Margin="0,4,0,0"
                                         Background="{DynamicResource InputBgBrush}" BorderThickness="0"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
