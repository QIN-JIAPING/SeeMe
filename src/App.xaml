<Application x:Class="SeeMe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ═══════════════ 浅色默认（App 级兜底；窗口级切换由 ThemeManager 控制） ═══════════════ -->

        <SolidColorBrush x:Key="AccentBrush"               Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentLightBrush"          Color="#EEF0FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"          Color="#1E1B4B"/>
        <SolidColorBrush x:Key="TextBodyBrush"             Color="#334155"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"        Color="#94A3B8"/>
        <SolidColorBrush x:Key="IconForegroundBrush"       Color="#64748B"/>
        <SolidColorBrush x:Key="DarkBtnBrush"              Color="#1E1B4B"/>
        <SolidColorBrush x:Key="LightGrayBrush"            Color="#E2E8F0"/>
        <SolidColorBrush x:Key="InputBgBrush"              Color="#F8FAFC"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush"     Color="#F1F5F9"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TitleBarActiveBackgroundBrush" Color="#EEF0FF"/>
        <SolidColorBrush x:Key="ItemHoverBrush"            Color="#F4F5FF"/>
        <SolidColorBrush x:Key="ItemSelectedBrush"         Color="#E0E3FF"/>
        <SolidColorBrush x:Key="DangerBrush"               Color="#EF4444"/>

        <!-- ═══════════════ 圆角 token（统一 16/12/10/8 四档，全项目复用） ═══════════════ -->
        <CornerRadius x:Key="PanelRadius">16</CornerRadius>
        <CornerRadius x:Key="CardRadius">12</CornerRadius>
        <CornerRadius x:Key="InputRadius">10</CornerRadius>
        <CornerRadius x:Key="ItemRadius">8</CornerRadius>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" Opacity="0.06"
                          ShadowDepth="3" Color="#6366F1"/>
        <DropShadowEffect x:Key="SidebarShadow" BlurRadius="14" Opacity="0.04"
                          ShadowDepth="2" Color="#6366F1"/>

        <!-- ═══════════════ 极简线性图标集（1.8px 描边 / 24×24 viewBox / 跟随 Foreground） ═══════════════ -->
        <!-- 亮色主题 -->
        <Geometry x:Key="IconSun">
            M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8
            M12,3 V5.5 M12,18.5 V21 M3,12 H5.5 M18.5,12 H21
            M5.64,5.64 L7.41,7.41 M16.59,16.59 L18.36,18.36
            M5.64,18.36 L7.41,16.59 M16.59,7.41 L18.36,5.64
        </Geometry>
        <!-- 暗色主题 -->
        <Geometry x:Key="IconMoon">
            M21,12.5 C21,17.75 16.75,22 11.5,22 C6.25,22 2,17.75 2,12.5
            C2,7.25 6.25,3 11.5,3 C11.5,3 7.5,7 7.5,12.5 C7.5,18 11.5,21.5 21,12.5 Z
        </Geometry>
        <!-- 打开文件 -->
        <Geometry x:Key="IconOpenFile">
            M4,18 V8 C4,7.45 4.45,7 5,7 H9.5 L11.5,9 H19 C19.55,9 20,9.45 20,10 V18
            C20,18.55 19.55,19 19,19 H5 C4.45,19 4,18.55 4,18 Z M4,10 H20
        </Geometry>
        <!-- 导出 -->
        <Geometry x:Key="IconExport">
            M4,14 H20 A1.5,1.5 0 0,1 21.5,15.5 V19.5 A1.5,1.5 0 0,1 20,21 H4
            A1.5,1.5 0 0,1 2.5,19.5 V15.5 A1.5,1.5 0 0,1 4,14 Z M12,4 V13 M8,9 L12,4 L16,9
        </Geometry>
        <!-- 隐藏信息面板 -->
        <Geometry x:Key="IconChevronLeft">M15,6 L9,12 L15,18</Geometry>
        <!-- 显示信息面板 -->
        <Geometry x:Key="IconChevronRight">M9,6 L15,12 L9,18</Geometry>
        <!-- 折叠最近文件 -->
        <Geometry x:Key="IconChevronDown">M6,9 L12,15 L18,9</Geometry>
        <!-- 设置：三条滑杆 + 圆钮（设置入口按钮用） -->
        <Geometry x:Key="IconGear">
            M4,9 A1.5,1.5 0 1,0 4,12 A1.5,1.5 0 1,0 4,9 Z M7,10.5 H21
            M12,15 A1.5,1.5 0 1,0 12,18 A1.5,1.5 0 1,0 12,15 Z M15,16.5 H21
            M20,21 A1.5,1.5 0 1,0 20,24 A1.5,1.5 0 1,0 20,21 Z M3,22.5 H17
        </Geometry>
        <!-- 色板/自定义样式：圆角方块 + 三点（CSS 按钮用，与主题按钮图标风格一致） -->
        <Geometry x:Key="IconPalette">
            M4,6 A2.5,2.5 0 0,1 6.5,3.5 L17.5,3.5 A2.5,2.5 0 0,1 20,6 L20,17.5 A2.5,2.5 0 0,1 17.5,20 L6.5,20 A2.5,2.5 0 0,1 4,17.5 Z
            M8.5,10 A1.5,1.5 0 1,0 8.5,13 A1.5,1.5 0 1,0 8.5,10 Z
            M12,10 A1.5,1.5 0 1,0 12,13 A1.5,1.5 0 1,0 12,10 Z
            M15.5,10 A1.5,1.5 0 1,0 15.5,13 A1.5,1.5 0 1,0 15.5,10 Z
        </Geometry>
        <!-- 切换分栏 -->
        <Geometry x:Key="IconSplit">
            M4,5 H11 A1.5,1.5 0 0,1 12.5,6.5 V17.5 A1.5,1.5 0 0,1 11,19 H4
            A1.5,1.5 0 0,1 2.5,17.5 V6.5 A1.5,1.5 0 0,1 4,5 Z
            M13,5 H20 A1.5,1.5 0 0,1 21.5,6.5 V17.5 A1.5,1.5 0 0,1 20,19 H13
            A1.5,1.5 0 0,1 11.5,17.5 V6.5 A1.5,1.5 0 0,1 13,5 Z
        </Geometry>
        <!-- 关闭面板 -->
        <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>
        <!-- 搜索：圆 r=7 + 手柄，对应 minimal_stroke_icon_set 的 search -->
        <Geometry x:Key="IconSearch">
            M10,3 A7,7 0 1,0 10,17 A7,7 0 1,0 10,3
            M15.5,15.5 L21,21
        </Geometry>
        <!-- 刷新/重载：圆弧箭头，顺时针旋转 -->
        <Geometry x:Key="IconRefresh">
            M17.65,6.35 C16.2,4.9 14.21,4 12,4 A8,8 0 0,0 4,12 A8,8 0 0,0 12,20
            C15.73,20 18.84,17.45 19.73,14 M17,1 V7 H23
        </Geometry>

        <!-- ═══════════════ 样式（用 DynamicResource 确保主题切换时引用跟随） ═══════════════ -->

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DarkBtnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CardRadius}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#374151"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮：红底 + 红色 hover（用于清空历史等破坏性确认） -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CardRadius}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource IconForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LightGrayBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 状态栏轻量文字按钮：透明底、无边框、hover 浅色反馈，与整体扁平风格一致 -->
        <Style x:Key="StatusBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource LightGrayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 轻量 chip 按钮：细边框 + 圆角 + hover 描边变靛蓝，用于左栏折叠标签/底部操作/Logo 区 -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightGrayBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 右键菜单主题：圆角 8px / 白底 / 1px 浅灰边框 / 极淡投影，替换 Windows 默认样式 ═══ -->
        <DropShadowEffect x:Key="MenuShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.10" Color="#1E1B4B"/>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightGrayBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <!-- 关掉系统弹窗阴影，只留模板内 MenuShadow，避免双层投影 -->
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="6"
                                Effect="{StaticResource MenuShadow}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项：高 32px、左右 padding 12px、hover 主题浅紫底 #EEF0FF，文字保持深灰。
             注意：keyed 样式，模板只呈现 Header（无 Icon 列/子菜单箭头/快捷键位），
             当前右键菜单全部用 Header 文本，未来若加子菜单/图标需扩展模板。 -->
        <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="2,1" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分隔线：1px 浅灰，上下 margin 4px。keyed 样式只挂右键菜单，不影响 SettingsDialog 的分隔线 -->
        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="#E8E8EA" Height="{TemplateBinding Height}"
                                Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ItemRadius}" Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                <Setter Property="Foreground" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
